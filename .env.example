# Telegram bot token from @BotFather
BOT_TOKEN=

# Database. SQLite works out of the box; for production PostgreSQL is recommended:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dragonlife
DATABASE_URL=sqlite+aiosqlite:///./dragonlife.db

# Random long string — used to sign panel login cookies
SECRET_KEY=change-me-to-a-long-random-string

# First admin account for the web panel (created on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Set to 1 and restart to reset the admin password to ADMIN_PASSWORD (remove afterwards)
# ADMIN_RESET=1

WEB_HOST=0.0.0.0
WEB_PORT=8000

# Public https address → bot uses webhook instead of polling (Render sets this automatically)
# WEBHOOK_URL=https://your-domain.com

CONTACT_USERNAME=@dragonlife02
CONTACT_PHONE=+998 97 661 16 66
